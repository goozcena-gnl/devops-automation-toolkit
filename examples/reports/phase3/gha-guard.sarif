{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gha-guard",
          "version": "1.0.1",
          "rules": [
            {
              "id": "GHA-PERMISSIONS-WRITE-ALL",
              "name": "gha_permissions_write_all",
              "shortDescription": {
                "text": "Workflow grants write-all permissions at workflow scope"
              },
              "help": {
                "text": "Replace write-all with the smallest per-scope permissions required by each job."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-PULL-REQUEST-TARGET",
              "name": "gha_pull_request_target",
              "shortDescription": {
                "text": "Workflow uses pull_request_target"
              },
              "help": {
                "text": "Avoid checking out or executing untrusted pull-request code in this event; split privileged and untrusted processing."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-CONCURRENCY-MISSING",
              "name": "gha_concurrency_missing",
              "shortDescription": {
                "text": "Workflow has no concurrency policy"
              },
              "help": {
                "text": "Add a concurrency group and cancel superseded runs where safe to reduce duplicate deployments and cost."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-TIMEOUT-MISSING",
              "name": "gha_timeout_missing",
              "shortDescription": {
                "text": "Job `audit` has no timeout"
              },
              "help": {
                "text": "Set timeout-minutes to bound hung commands and hosted-runner consumption."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-SELF-HOSTED-RUNNER",
              "name": "gha_self_hosted_runner",
              "shortDescription": {
                "text": "Job `audit` uses a self-hosted runner"
              },
              "help": {
                "text": "Isolate ephemeral runners, restrict repository access, and never run untrusted fork code on persistent runners."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-ACTION-NOT-SHA-PINNED",
              "name": "gha_action_not_sha_pinned",
              "shortDescription": {
                "text": "Action `actions/checkout` is not pinned to a full commit SHA"
              },
              "help": {
                "text": "Replace the mutable tag or branch with a reviewed 40-character commit SHA."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-CHECKOUT-PERSIST-CREDENTIALS",
              "name": "gha_checkout_persist_credentials",
              "shortDescription": {
                "text": "Checkout credentials remain persisted"
              },
              "help": {
                "text": "Set `persist-credentials: false` unless later steps explicitly require the GitHub token in Git configuration."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-ARTIFACT-RETENTION",
              "name": "gha_artifact_retention",
              "shortDescription": {
                "text": "Artifact retention is not explicitly bounded"
              },
              "help": {
                "text": "Set retention-days according to data sensitivity and operational need."
              },
              "properties": {
                "category": "github-actions"
              }
            },
            {
              "id": "GHA-UNTRUSTED-INPUT-IN-SHELL",
              "name": "gha_untrusted_input_in_shell",
              "shortDescription": {
                "text": "Untrusted event data is interpolated directly into a shell command"
              },
              "help": {
                "text": "Pass the expression through an environment variable and quote it safely, or process it with a non-shell action."
              },
              "properties": {
                "category": "github-actions"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "GHA-PERMISSIONS-WRITE-ALL",
          "level": "error",
          "message": {
            "text": "Workflow grants write-all permissions at workflow scope"
          },
          "partialFingerprints": {
            "primaryLocationLineHash": "sha256:e04d88285b46d5c3aaef110bc54d48cc6be4f2d40369807200b64b6df3277dc7"
          },
          "properties": {
            "category": "github-actions",
            "confidence": "high",
            "suppressed": false,
            "recommendation": "Replace write-all with the smallest per-scope permissions required by each job."
          },
          "locations": [
            {
              "physicalLocation": {
